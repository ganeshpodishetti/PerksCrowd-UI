# Static asset headers for Cloudflare Workers (OpenNext)
# Security headers for dynamic responses are applied via next.config.ts headers()
/*
  # Security headers
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

  # CSP - inline scripts/styles allowed because HTML is prerendered at build time
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.perkscrowd.com https://ik.imagekit.io; frame-ancestors 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

  # Report-only CSP for monitoring (same as enforced)
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline'; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.perkscrowd.com https://ik.imagekit.io; frame-ancestors 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

  # HSTS - Enable for production security
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Cache control for static assets
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Cache control for JavaScript files
/*.js
  Cache-Control: public, max-age=86400

# Cache control for CSS files  
/*.css
  Cache-Control: public, max-age=86400

# Keep HTML prerendered routes fresh, serve from Cloudflare edge cache
/*.html
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

# Prerendered public routes — serve from Cloudflare edge cache
/
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/deals
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/categories
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/stores
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/universities
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/brand-use
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

/terms
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=86400

# Sitemap - must be XML
/sitemap.xml
  Content-Type: application/xml
  Cache-Control: public, max-age=86400, s-maxage=86400

# Robots file
/robots.txt
  Cache-Control: public, max-age=86400, s-maxage=86400
